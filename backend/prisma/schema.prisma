generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The BRIN index on timestamp, the GIN index on attributes and the pg_trgm
/// index on body are not expressible here. They live in the manual migration
/// 20260909130000_search_indexes — see docs/adr/0003 and docs/adr/0009.
model LogRecord {
  id             String   @id @default(uuid()) @db.Uuid
  timestamp      DateTime @db.Timestamptz(3)
  observedAt     DateTime @default(now()) @map("observed_at") @db.Timestamptz(3)
  severityNumber Int?     @map("severity_number")
  severityText   String?  @map("severity_text")
  body           String
  serviceName    String?  @map("service_name")
  host           String?
  environment    String?
  traceId        String?  @map("trace_id")
  spanId         String?  @map("span_id")
  attributes     Json     @default("{}")
  sourceType     String   @map("source_type")
  fingerprint    String
  raw            String
  importJobId    String   @map("import_job_id") @db.Uuid

  issue     Issue     @relation(fields: [fingerprint], references: [fingerprint])
  importJob ImportJob @relation(fields: [importJobId], references: [id])

  @@index([serviceName, severityNumber, timestamp(sort: Desc)])
  @@index([fingerprint, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc), id(sort: Desc)])
  @@map("log_records")
}

model Issue {
  fingerprint      String      @id
  sampleMessage    String      @map("sample_message")
  severityNumber   Int?        @map("severity_number")
  firstSeen        DateTime    @map("first_seen") @db.Timestamptz(3)
  lastSeen         DateTime    @map("last_seen") @db.Timestamptz(3)
  eventCount       BigInt      @default(0) @map("event_count")
  affectedServices String[]    @map("affected_services")
  status           IssueStatus @default(UNRESOLVED)
  resolvedAt       DateTime?   @map("resolved_at") @db.Timestamptz(3)
  regression       Boolean     @default(false)

  records LogRecord[]

  @@index([status, lastSeen(sort: Desc)])
  @@map("issues")
}

enum IssueStatus {
  UNRESOLVED
  RESOLVED
  IGNORED
}

model ImportJob {
  id             String    @id @default(uuid()) @db.Uuid
  filename       String
  storageKey     String    @map("storage_key")
  sizeBytes      BigInt    @map("size_bytes")
  sourceType     String?   @map("source_type")
  status         JobStatus @default(PENDING)
  totalLines     Int?      @map("total_lines")
  processedLines Int       @default(0) @map("processed_lines")
  parseErrors    Int       @default(0) @map("parse_errors")
  elapsedMs      Int?      @map("elapsed_ms")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  records LogRecord[]

  @@map("import_jobs")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

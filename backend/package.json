{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/http/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../.env src/worker/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "openapi:dump": "tsx src/http/openapi-dump.ts",
    "generate:logs": "tsx src/scripts/generate-logs.ts",
    "ingest": "tsx --env-file-if-exists=../.env src/cli/ingest.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.0.0",
    "domain-constants": "workspace:*",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.0",
    "ioredis": "^5.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

{
  "openapi": "3.0.3",
  "info": {
    "title": "log-platform API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "LogListQuery": {
        "type": "object",
        "properties": {
          "level": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "unknown"
                    ]
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  }
                ]
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "unknown"
                      ]
                    },
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 24
                    }
                  ]
                }
              }
            ]
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "service": {
            "type": "string",
            "minLength": 1
          },
          "q": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LogRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "severityNumber": {
            "type": "integer",
            "nullable": true
          },
          "severityText": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "string"
          },
          "serviceName": {
            "type": "string",
            "nullable": true
          },
          "host": {
            "type": "string",
            "nullable": true
          },
          "environment": {
            "type": "string",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "nullable": true
          },
          "spanId": {
            "type": "string",
            "nullable": true
          },
          "sourceType": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "timestamp",
          "observedAt",
          "severityNumber",
          "severityText",
          "body",
          "serviceName",
          "host",
          "environment",
          "traceId",
          "spanId",
          "sourceType",
          "fingerprint"
        ],
        "additionalProperties": false
      },
      "LogListResponse": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogRecord"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "records",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "CreateImportResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "ImportStatusResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "filename": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed"
            ]
          },
          "sourceType": {
            "type": "string",
            "nullable": true
          },
          "totalLines": {
            "type": "integer",
            "nullable": true
          },
          "processedLines": {
            "type": "integer"
          },
          "parseErrors": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "result": {
            "type": "object",
            "properties": {
              "ingestedRecords": {
                "type": "integer"
              },
              "elapsedMs": {
                "type": "integer"
              },
              "linesPerSecond": {
                "type": "number"
              }
            },
            "required": [
              "ingestedRecords",
              "elapsedMs",
              "linesPerSecond"
            ],
            "additionalProperties": false,
            "nullable": true
          }
        },
        "required": [
          "id",
          "filename",
          "status",
          "sourceType",
          "totalLines",
          "processedLines",
          "parseErrors",
          "createdAt",
          "finishedAt",
          "error",
          "result"
        ],
        "additionalProperties": false
      },
      "ImportListResponse": {
        "type": "object",
        "properties": {
          "imports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "filename": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "running",
                    "completed",
                    "failed"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "totalLines": {
                  "type": "integer",
                  "nullable": true
                },
                "processedLines": {
                  "type": "integer"
                },
                "parseErrors": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "filename",
                "status",
                "createdAt",
                "totalLines",
                "processedLines",
                "parseErrors"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "imports"
        ],
        "additionalProperties": false
      },
      "ErrorRateResponse": {
        "type": "object",
        "properties": {
          "buckets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bucket": {
                  "type": "string",
                  "format": "date-time"
                },
                "total": {
                  "type": "number"
                },
                "errors": {
                  "type": "number"
                },
                "ratio": {
                  "type": "number"
                }
              },
              "required": [
                "bucket",
                "total",
                "errors",
                "ratio"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "buckets"
        ],
        "additionalProperties": false
      },
      "NewIssuesResponse": {
        "type": "object",
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fingerprint": {
                  "type": "string"
                },
                "sampleMessage": {
                  "type": "string"
                },
                "severity": {
                  "type": "integer",
                  "nullable": true
                },
                "eventCount": {
                  "type": "number"
                },
                "firstSeen": {
                  "type": "string",
                  "format": "date-time"
                },
                "services": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "fingerprint",
                "sampleMessage",
                "severity",
                "eventCount",
                "firstSeen",
                "services"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "issues"
        ],
        "additionalProperties": false,
        "description": "Issues first seen within the window"
      },
      "TopIssuesResponse": {
        "type": "object",
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fingerprint": {
                  "type": "string"
                },
                "sampleMessage": {
                  "type": "string"
                },
                "severity": {
                  "type": "integer",
                  "nullable": true
                },
                "eventCount": {
                  "type": "number"
                },
                "firstSeen": {
                  "type": "string",
                  "format": "date-time"
                },
                "services": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "fingerprint",
                "sampleMessage",
                "severity",
                "eventCount",
                "firstSeen",
                "services"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "issues"
        ],
        "additionalProperties": false,
        "description": "Issues ranked by event count within the window"
      },
      "SpikesResponse": {
        "type": "object",
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fingerprint": {
                  "type": "string"
                },
                "sampleMessage": {
                  "type": "string"
                },
                "severity": {
                  "type": "integer",
                  "nullable": true
                },
                "eventCount": {
                  "type": "number"
                },
                "firstSeen": {
                  "type": "string",
                  "format": "date-time"
                },
                "services": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "currentCount": {
                  "type": "number"
                },
                "previousCount": {
                  "type": "number"
                },
                "multiplier": {
                  "type": "number"
                }
              },
              "required": [
                "fingerprint",
                "sampleMessage",
                "severity",
                "eventCount",
                "firstSeen",
                "services",
                "currentCount",
                "previousCount",
                "multiplier"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "issues"
        ],
        "additionalProperties": false
      },
      "ByServiceResponse": {
        "type": "object",
        "properties": {
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "serviceName": {
                  "type": "string"
                },
                "total": {
                  "type": "number"
                },
                "errors": {
                  "type": "number"
                }
              },
              "required": [
                "serviceName",
                "total",
                "errors"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "services"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/logs": {
      "get": {
        "parameters": [
          {
            "schema": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "unknown"
                      ]
                    },
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 24
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "unknown"
                        ]
                      },
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 24
                      }
                    ]
                  }
                }
              ]
            },
            "in": "query",
            "name": "level",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "in": "query",
            "name": "from",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "in": "query",
            "name": "to",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "in": "query",
            "name": "service",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "q",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "cursor",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/error-rate": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "in": "query",
            "name": "from",
            "required": true
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "in": "query",
            "name": "to",
            "required": true
          }

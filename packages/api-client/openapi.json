            "in": "query",
            "name": "limit",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Issues ranked by event count within the window",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopIssuesResponse"
                }
              }
            }
          }
        }
      }
    },

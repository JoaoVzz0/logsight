{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm check:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm test:e2e:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(tsc:*)",
      "Bash(eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)"
    ],
    "ask": [
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm up:*)",
      "Bash(pnpm update:*)",
      "Bash(pnpm --filter backend prisma:migrate:*)",
      "Bash(pnpm --filter backend prisma:generate:*)",
      "Bash(prisma migrate:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(git push:*)"
    ]
  }
}
